{
  "manifest_version": 3,
  "name": "DeepSeek Web Bridge (local)",
  "version": "0.1.0",
  "description": "Expose the signed-in DeepSeek Web tab to local tools through a loopback bridge.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DeepSeek Web Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
